{
  "$schema": "https://nodejs.org/dist/v24.21.0/docs/node-config-schema.json",
  "nodeOptions": {
    "experimental-webstorage": true,
    "import": [
      "./test/snapshots.ts"
    ],
    "localstorage-file": "./test/.storage",
    "warnings": false
  },
  "test": {
    "experimental-test-module-mocks": true,
    "experimental-test-coverage": true,
    "test-coverage-include": [
      "build/**/*.ts",
      "src/**/*.ts"
    ],
    "test-coverage-exclude": [
      "**/*.fixt.ts",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "test-reporter": [
      "lcov",
      "spec"
    ],
    "test-reporter-destination": [
      "./coverage.lcov",
      "stdout"
    ]
  }
}
