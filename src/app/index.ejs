<!DOCTYPE html>

<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<% if (assets.webmanifest) { %>
			<link rel="manifest" href="<%= assets.webmanifest %>" />
		<% } %>
		<% if (assets.favicon) { %>
			<link rel="apple-touch-icon" href="<%= assets.favicon %>" />
			<link rel="icon" href="<%= assets.favicon %>" />
		<% } %>
		<% for (const href of assets.css) { %>
			<link rel="stylesheet" href="<%= href %>" />
		<% } %>
		<% for (const { isModule, src } of assets.scripts) { %>
			<script src="<%= src %>" type="module"></script>
		<% } %>

		<% if (meta.description) { %>
			<meta name="description" content="<%= meta.description %>" />
			<meta property="og:description" content="<%= meta.description %>">
		<% } %>

		<% if (assets.ogImage) { %>
			<meta property="og:image" content="<%= assets.ogImage %>">
		<% } %>

		<meta property="og:title" content="<%= meta.name %>">
		<meta property="og:type" content="website">

		<title><%= meta.name %></title>
	</head>

	<body class="flex direction-column">
		<% if (hot) { %>
			<script type="module">
				new EventSource('/esbuild').addEventListener('change', e => {
					const { added, removed, updated } = JSON.parse(e.data)

					if (!added.length && !removed.length && updated.length === 1) {
						for (const link of document.getElementsByTagName('link')) {
							const url = new URL(link.href)

							if (url.host === location.host && url.pathname === updated[0]) {
								const next = link.cloneNode();
								next.href = `${updated[0]}?${Math.random().toString(36).slice(2)}`;
								next.onload = () => link.remove();
								return link.parentNode.insertBefore(next, link.nextSibling);
							}
						}
					}

					location.reload();
				});
			</script>
		<% } %>
	</body>
</html>
