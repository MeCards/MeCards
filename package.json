{
  "name": "MeCards",
  "version": "1.0.0-rc.5",
  "description": "Store membership cards offline, locally on your device; no sketchy shit.",
  "keywords": [
    "barcodes",
    "persistent storage",
    "PWA",
    "mobile web app",
    "membership cards"
  ],
  "homepage": "https://MeCards.app",
  "bugs": {
    "url": "https://github.com/MeCards/MeCards/issues"
  },
  "repository": "github:MeCards/MeCards",
  "license": "CC-BY-NC-4.0",
  "author": "JakobJingleheimer",
  "type": "module",
  "main": "./src/main.tsx",
  "scripts": {
    "build": "rm -rf ./docs && node ./build/prod.ts",
    "build:prod": "NODE_ENV=production node --run build",
    "dev": "NODE_ENV=development PORT=8443 rm -rf ./docs && node ./build/dev.ts",
    "start": "node --run build && node --run serve",
    "start:prod": "node --run build:prod && node --run serve",
    "serve": "PORT=8443 http-server -S -C ./cert.pem -K key.pem ./docs",
    "test:ui": "node --experimental-config-file=./node.config.test.json --import './test/dom.setup.ts' --test",
    "test:uis": "node --run test:ui -- './src/**/*.test.ts'",
    "test:vanilla": "rm -f ./test/.storage && touch ./test/.storage; node --experimental-config-file=./node.config.test.json --test",
    "test:vanillas": "node --run test:vanilla -- './build/**/*.spec.ts' './src/**/*.spec.ts'",
    "types:check": "tsc --build --noEmit"
  },
  "dependencies": {
    "@tabler/icons": "^3.46.0",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "kelpui": "^1.17.2",
    "lodash.debounce": "^4.0.8",
    "nanoid": "^6.0.1",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@happy-dom/node-canvas-adapter": "^20.14.5",
    "@jedmao/location": "^3.0.0",
    "@testing-library/preact": "^3.2.4",
    "@types/ejs": "^3.1.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.5.1",
    "@types/serviceworker": "^0.0.202",
    "@types/web-app-manifest": "^1.0.9",
    "canvas": "^3.2.3",
    "ejs": "^6.0.1",
    "esbuild": "^0.25.12",
    "esbuild-plugin-svgr": "^3.1.1",
    "mime-types": "^3.0.2",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "http-server": "^14.1.1"
  }
}
